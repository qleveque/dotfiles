#!/usr/bin/env zsh

cmd=$1 && shift

case ${cmd} in
  paste)
    # Same behavior as Ctrl+V in Explorer (uses Explorer's Paste verb in current directory)
    powershell.exe -NoProfile -Command \
      '$shell = New-Object -ComObject Shell.Application; `
      $destPath = (Get-Location).Path; `
      $dest = $shell.Namespace($destPath); `
      if (-not $dest) { throw "Cannot access destination folder: $destPath" } `
      $dest.Self.InvokeVerb("paste")'
  ;;

  copy)
    # Same clipboard format as Ctrl+C in Explorer
    for a in "$@"; do echo "$a"; done | powershell.exe -NoProfile -Command \
      'Add-Type -AssemblyName System.Windows.Forms; `
      $paths = $input -split "`n" | Where-Object { $_ -and $_.Trim() -ne "" }; `
      $c = New-Object Collections.Specialized.StringCollection; `
      $paths | ForEach-Object { `
        $fullPath = (Resolve-Path -LiteralPath (Join-Path (Get-Location) $_)).Path; `
        [void]$c.Add($fullPath) `
      }; `
      $data = New-Object System.Windows.Forms.DataObject; `
      $data.SetFileDropList($c); `
      $bytes = [BitConverter]::GetBytes([int]5); `
      $stream = New-Object System.IO.MemoryStream(,$bytes); `
      $data.SetData("Preferred DropEffect", $stream); `
      [System.Windows.Forms.Clipboard]::SetDataObject($data, $true)'
  ;;

  cut)
    # Same clipboard format as Ctrl+X in Explorer
    for a in "$@"; do echo "$a"; done | powershell.exe -NoProfile -Command \
      'Add-Type -AssemblyName System.Windows.Forms; `
      $paths = $input -split "`n" | Where-Object { $_ -and $_.Trim() -ne "" }; `
      $c = New-Object Collections.Specialized.StringCollection; `
      $paths | ForEach-Object { `
        $fullPath = (Resolve-Path -LiteralPath (Join-Path (Get-Location) $_)).Path; `
        [void]$c.Add($fullPath) `
      }; `
      $data = New-Object System.Windows.Forms.DataObject; `
      $data.SetFileDropList($c); `
      $bytes = [BitConverter]::GetBytes([int]2); `
      $stream = New-Object System.IO.MemoryStream(,$bytes); `
      $data.SetData("Preferred DropEffect", $stream); `
      [System.Windows.Forms.Clipboard]::SetDataObject($data, $true)'
  ;;

  delete)
    # Same behavior as Delete in Explorer (Shell delete verb, typically to Recycle Bin)
    for a in "$@"; do echo "$a"; done | powershell.exe -NoProfile -Command \
      '$shell = New-Object -ComObject Shell.Application; `
      $paths = $input -split "`n" | Where-Object { $_ -and $_.Trim() -ne "" }; `
      $paths | ForEach-Object { `
        $fullPath = (Resolve-Path -LiteralPath (Join-Path (Get-Location) $_)).Path; `
        $parent = [System.IO.Path]::GetDirectoryName($fullPath); `
        $leaf = [System.IO.Path]::GetFileName($fullPath); `
        $folder = $shell.Namespace($parent); `
        if ($folder) { `
          $item = $folder.ParseName($leaf); `
          if ($item) { $item.InvokeVerb("delete") } `
        } `
      }'
  ;;
esac
