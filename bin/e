#!/usr/bin/zsh
# Edit any file

full_path="$(readlink -f "$1")"
ext="${full_path:t:e}"

# Check if binary file
[[ -s $1 ]]&&file -i "$1"|grep -q '.*: application/\S\+; charset=binary$'&&ext='bin'

if grep -q Microsoft /proc/version; then
  # Setup Windows arguments
  wargs=("$@") && [[ "$#" -ne 0 ]] && wargs[1]=$(wslpath -m -- ${full_path})
  case ${ext} in
    png|jpg) cmd.exe /C start '' 'mspaint.exe' "${wargs[@]}";;
    mp3) cmd.exe /C start '' 'C:/Program Files/Audacity/Audacity.exe' "${wargs[@]}";;
    bin) cmd.exe /C start '' 'C:/Program Files/ImHex/imhex.exe' "${wargs[@]}";;
    *) nvim "$@";;
  esac
else
  case ${ext} in
    *) nvim "$@";;
  esac
fi
