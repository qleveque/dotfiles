#!/usr/bin/zsh
# Edit any file

full_path="$(readlink -f "$1")"
ext="${full_path:t:e}"

if grep -q Microsoft /proc/version; then
  win_args=("$@")
  [[ "$#" -ne 0 ]] && win_args[1]=$(wslpath -m -- ${full_path})
  case ${ext} in
    png|jpg) mspaint.exe "${win_args[@]}" &;;
    mp3) "/mnt/c/Program Files/Audacity/Audacity.exe" "${win_args[@]}" &;;
    *) nvim "$@";;
  esac
else
  case ${ext} in
    *) nvim "$@";;
  esac
fi
