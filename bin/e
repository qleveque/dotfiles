#!/usr/bin/zsh
# Edit any file

full_path="$(readlink -f "$1")"
ext="${full_path:t:e}"

if grep -q Microsoft /proc/version; then
  args=("$@")
  [[ "$#" -ne 0 ]] && args[1]=$(wslpath -m -- ${full_path})
  if [[ -s "$1" ]] && file --mime-encoding $1 | grep '\bbinary$'; then
    '/mnt/c/Program Files/ImHex/imhex.exe' "${args[@]}" &;
    exit 0
  fi
  case ${ext} in
    png|jpg) mspaint.exe "${args[@]}" &;;
    mp3) '/mnt/c/Program Files/Audacity/Audacity.exe' "${args[@]}" &;;
    *) nvim "$@";;
  esac
else
  case ${ext} in
    *) nvim "$@";;
  esac
fi
