#!/bin/bash
f=$(mktemp)
[[ "$1" != "-1" ]] && pane_id="--pane-id $1"
shift
grep -q Microsoft /proc/version && WEZTERM="wezterm.exe" || WEZTERM="wezterm"
${WEZTERM} cli get-text ${pane_id} --start-line '-1000' > $f
sd ' *\n' '\n' $f
sed -i ':a;/^\n*$/{$d;N;};/\n$/ba' $f
nvim --cmd 'lua light=true' -c 'set ls=0' "$@" $f
