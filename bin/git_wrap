#!/usr/bin/zsh
key="$1"
shift

while getopts "h:i:f:l:r:ns" opt; do case $opt in
  f) file="$(realpath -s --relative-to="${PWD}" "${OPTARG}")" ;;
  l) line="${OPTARG}";;
  r) ref="${OPTARG}^ ${OPTARG}";;
  n) no_new_tab=1;;
  s) ref='--staged';;
  i) index="${OPTARG}";;
  h) hash="${OPTARG}";;
esac; done
shift $((OPTIND -1))

run() {
  tab_title="$1"
  shift
  if [[ ${no_new_tab} ]]; then
    eval "$@"
  else
    wez_wrap new "${tab_title}" "$@" > /dev/null
  fi
}

read-commit-line() {
  read line
  if [[
      "$line" =~ '^commit\ (\w+)' ||
      "$line" =~ '(HEAD@\{[0-9]+\})' ||
      "$line" =~ '(stash@\{[0-9]+\})' ||
      "$line" =~ '^[*| ]* (\w+)'
    ]]; then
    echo "${match[1]}"
    return
  fi
  echo NO_COMMIT
}

case $key in
  d) run "git diff: ${file:t}" "NVIM_DIFF=1 nvim +\":DiffviewOpen -uno -- '${file}'\"";;
  s) run "git status: $(basename `git rev-parse --show-toplevel`)" "NVIM_DIFF=1 nvim +:DiffviewOpen";;
  f) run "git logfile:${file:t}" "NVIM_DIFF=1 nvim +\":DiffviewFileHistory ${file}\"";;
  l) run "git log: $(basename `git rev-parse --show-toplevel`)" "NVIM_DIFF=1 nvim +:DiffviewFileHistory";;
  c) run "git commit" "git commit || read";;
  a) run "git commit amend" "git commit --amend || read";;
  n) run "git commit amend no-edit" "git commit --amend --no-edit || read";;
  C) run "git commit amend no-edit" "git commit --amend --no-edit && git push --force || read";;
  o)
    [ -z $hash ] && hash=$(cb paste)
    run "git-show:${hash}" "; NVIM_DIFF=1 nvim +\":DiffviewOpen ${hash}^..${hash} -- $file \""
  ;;
  read-commit) read-commit-line;;
  inlog)
    commit=$(read-commit-line)
    lines=$(cat)
    file=$(print -r -- $lines | grep '^diff --git' | tail -n1 | awk '{match($0, / b\/(.*)$/, arr); print arr[1]}')
    [[ $1 == copy ]] && echo ${file} | cb copy && exit 0
    git_wrap o -h ${commit} ${file:+-f "$file"}
  ;;
esac
