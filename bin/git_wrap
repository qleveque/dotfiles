#!/usr/bin/zsh

cmd=""
key="$1"
use_wez=1
copy=
shift

while getopts "i:f:l:r:ncs" opt; do case $opt in
  f) file=$(realpath -s --relative-to="${PWD}" "${OPTARG}") ;;
  l) line="${OPTARG}";;
  r) ref="${OPTARG}^ ${OPTARG}";;
  n) use_wez=;;
  s) ref='--staged';;
  c) copy=1;;
esac; done
shift $((OPTIND -1))

run() {
  tab_title="$1"
  shift
  if [[ ${use_wez} ]]; then
    wez_wrap new "${tab_title}" "$(printf "%q " "$@")"
  else
    eval "$@"
  fi
}

case $key in
  d) run "git-diff:${file:t}" NVIM_GITDIFF=1 FILE="${PWD}/${file}" git difftool ${=ref} -- "${file}";;
  s) run "git-status:$(basename `git rev-parse --show-toplevel`)" gitrs status;;
  f) run "git-logfile:${file:t}" git log "${file}";;
  l) run "git-log:$(basename `git rev-parse --show-toplevel`)" git log;;
  b) run "git-blame:${file:t}" gitrs blame "${file}" -L ${line:-1};;
  merge) run "git-merge:${file:t}" NVIM_GITMERGE=1 FILE="${PWD}/${file}" git_mergetool "${file}";;
  pick) run "git-pick:${file:t}" NVIM_GITDIFF=1 git pick "${file}";;
  untracked) run "untracked:${file:t}" nvim "${file}";;
  index)
    read idx
    shown_commit=$(git log --raw --all --find-object="${idx:0:7}" -n1)
    ref=$(echo ${shown_commit} | head -n1 | sd '^commit ' '')
    file=$(echo ${shown_commit} | tail -n1 | sd '^.*\t' '')
    git_wrap d -f "${file}" -r "${ref}"
  ;;
  commit-line)
    read line
    if [[ "$line" =~ ^commit\ (.+) ]]; then
      commit=$(echo "$line" | awk '{print $2}')
    elif [[ "$line" =~ '(stash@\{[0-9]+\})' ]]; then
      commit="${match[1]}"
    elif [[ "$line" =~ '(HEAD@\{[0-9]+\})' ]]; then
      commit="${match[1]}"
    else
      commit=$(echo "$line" | sed 's/^[*| ]*//' | awk '{print $1}')
    fi
    if [[ ${copy} ]]; then
      echo ${commit} | cb copy
    else
      gitrs show ${commit}
    fi
  ;;
esac
