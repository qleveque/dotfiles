#!/usr/bin/zsh

key="$1" file=$(realpath -s --relative-to="${PWD}" "$2")
shift 2
export FILE="${PWD}/${file}"
export NVIM_LIGHT=1

while getopts "l:r:s" opt; do case $opt in
    l) line="${OPTARG}";;
    r) ref="${OPTARG}^ ${OPTARG}";;
    s) ref='--staged';;
esac; done
shift $((OPTIND -1))

case $key in
  d) git difftool ${=ref} -- "${file}";;
  s) tig status;;
  f) tig "${file}";;
  l) tig;;
  b) tig blame +${line:-1} "${file}";;
  r) tig reflog;;
  t) tig stash --list;;
  m) git_mergetool "${file}";;
  p)
    tmp=$(mktemp)
    mv "${file}" "${tmp}"
    touch "${file}"
    git restore "${file}" &> /dev/null
    nvim -d "${tmp}" "${file}"
    [[ -s "${file}" ]] && git add "${file}"
    mv ${tmp} "${file}"
  ;;
esac
