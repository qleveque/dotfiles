#!/usr/bin/zsh

key="$1" file=$(realpath -s --relative-to="${PWD}" "$2")
case $key in
  d) git difftool "${file}";;
  s) tig status;;
  f) tig "${file}";;
  l) tig;;
  b) line="$3" && tig blame +${line:-1} "${file}" ;;
  r) tig reflog;;
  t) tig stash --list;;
  p)
    tmp=$(mktemp)
    mv "${file}" "${tmp}"
    touch "${file}"
    git restore "${file}" &> /dev/null
    NVIM_LIGHT=1 FILE="${PWD}/${file}" nvim -d "${tmp}" "${file}"
    [[ -s "${file}" ]] && git add "${file}"
    mv ${tmp} "${file}"
  ;;
  *) return;;
esac
