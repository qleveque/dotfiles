#!/bin/zsh

if grep -q Microsoft /proc/version; then
  wez='wezterm.exe' cwd="$(wslpath -m ${PWD})"
else
  wez='wezterm' cwd="${PWD}"
fi
cmd=$1 && shift

# Hacks to spawn tab next to current one
pane_id() {
  ${wez} cli list-clients --format json|jq -r '.[0].focused_pane_id'
}
tab_position() {
  list=$(${wez} cli list --format json)
  tab_id=$(jq -r ".[]|select(.pane_id == $1)|.tab_id" <<< "${list}")
  window_id=$(jq -r ".[]|select(.pane_id == $1)|.window_id" <<< "${list}")
  jq -r ".[]|select(.window_id == ${window_id})|.tab_id" <<< "${list}"|uniq|grep -n ${tab_id}|cut -d: -f1
}
move_tab_next() {
  echo 'printf "\033]1337;SetUserVar=%s=%s\007"' MOVE_TAB $(echo -n $(tab_position $(pane_id))|base64)
}

case ${cmd} in
  copy)
    [[ -n $1 ]] && pane_id="--pane-id $1"
    f=$(mktemp)
    ${wez} cli get-text ${=pane_id} --start-line '-1000' | sd ' *\n' '\n' | sed ':a;/^\n*$/{$d;N;};/\n$/ba' > $f
    if [[ -n $1 ]]; then
      NVIM_COPY=1 wez_wrap new copy-mode "nvim -c 'norm G' $f"
    else
      NVIM_COPY=1 nvim -c "norm G3k^" $f
    fi
  ;;
  split) ${wez} cli split-pane --bottom --cwd ${cwd} -- zsh -c "$1";;
  new) ${wez} cli spawn --cwd ${cwd} -- zsh -c "$(move_tab_next) &; ${wez} cli set-tab-title '$1' &; $2; wez_wrap kill";;
  kill)
    pane=$(pane_id)
    ${wez} cli activate-tab --tab-index $(( $(tab_position ${pane}) - 2 ))
    ${wez} cli kill-pane --pane-id ${pane} &
  ;;
  nvim) ${wez} start --cwd="${cwd}" bash -c "nvim '$1' +$2";;
  cd)
    if grep -q Microsoft /proc/version; then
      wd="$(wslpath -w $1)"
    else
      wd="$1"
    fi
    ${wez} set-working-directory "${wd}"
  ;;
esac
