#!/usr/bin/env zsh

cmd="$1" && shift

case ${cmd} in
  split) zellij action new-pane --cwd "${PWD}" --name "" --close-on-exit --floating -- zsh -c "$1" ;;
  new) zellij action new-tab --name "$1" --cwd "${PWD}" --close-on-exit -- zsh -c "zellij action rename-pane ''; $2";;
  nvim) zj-wrap new "sh -c \"nvim '$1' +$2\"";;
esac
