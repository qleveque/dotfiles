#!/bin/zsh

if grep -q Microsoft /proc/version; then
  WEZTERM="wezterm.exe" cwd="$(wslpath -m ${PWD})"
else
  WEZTERM="wezterm" cwd="${PWD}"
fi

cmd=$1 && shift

# Hacks to spawn tab next to current one
tab_position() {
  local pane_id=$(${WEZTERM} cli list-clients --format json|jq -r '.[0].focused_pane_id')
  local list=$(${WEZTERM} cli list --format json|jq -r ".[]|select(.pane_id == ${pane_id})|.tab_id, .window_id")
  { read -r tab_id; read -r window_id } <<< "${list}"
  ${WEZTERM} cli list --format json|jq -r ".[]|select(.window_id == ${window_id})|.tab_id"|uniq|grep -n ${tab_id}|cut -d: -f1
}
move_tab_next() {
  echo 'printf "\033]1337;SetUserVar=%s=%s\007"' MOVE_TAB $(echo -n $(tab_position) | base64)
}
[[ "${cmd}" == "_prev" ]] && ${WEZTERM} cli activate-tab --tab-index $(( $(tab_position) - 2 )) && exit 0

case ${cmd} in
  copy)
    [[ "$1" != "-1" ]] && pane_id="--pane-id $1"
    shift
    f=$(mktemp)
    ${WEZTERM} cli get-text ${=pane_id} --start-line '-1000' > $f
    sd ' *\n' '\n' $f
    sed -i ':a;/^\n*$/{$d;N;};/\n$/ba' $f
    nvim --cmd 'lua light=true' -c 'set ls=0' -c 'norm G' "$@" $f
  ;;
  split) ${WEZTERM} cli split-pane --bottom --cwd ${cwd} -- zsh -c "$@";;
  new) ${WEZTERM} cli spawn --cwd ${cwd} -- zsh -c "$(move_tab_next); $@; wez _prev";;
esac
