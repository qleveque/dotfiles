#!/bin/zsh

if grep -q Microsoft /proc/version; then
  CLI='wezterm.exe cli' cwd="$(wslpath -m ${PWD})"
else
  CLI='wezterm cli' cwd="${PWD}"
fi
cmd=$1 && shift

# Hacks to spawn tab next to current one
pane_id() {
  ${=CLI} list-clients --format json|jq -r '.[0].focused_pane_id'
}
tab_position() {
  local pane_id=$()
  { read -r tab_id; read -r window_id } <<< $(${=CLI} list --format json\
    |jq -r ".[]|select(.pane_id == $(pane_id))|.tab_id, .window_id")
  ${=CLI} list --format json|jq -r ".[]|select(.window_id == ${window_id})|.tab_id"\
    |uniq|grep -n ${tab_id}|cut -d: -f1
}
move_tab_next() {
  echo 'printf "\033]1337;SetUserVar=%s=%s\007"' MOVE_TAB $(echo -n $(tab_position)|base64)
}

case ${cmd} in
  copy-pane) nvim_cmd='norm G' pane_id="--pane-id $1" && shift;|
  copy) nvim_cmd='norm G3k^';|
  copy*)
    f=$(mktemp)
    ${=CLI} get-text ${=pane_id} --start-line '-1000' > $f
    sd ' *\n' '\n' $f
    sed -i ':a;/^\n*$/{$d;N;};/\n$/ba' $f
    NVIM_LIGHT=1 nvim -c 'set ls=0' -c 'set nonu' -c "${nvim_cmd}" "$@" $f
  ;;
  split) ${=CLI} split-pane --bottom --cwd ${cwd} -- zsh -c "$@";;
  new) ${=CLI} spawn --cwd ${cwd} -- zsh -c "$(move_tab_next); $@; wez kill";;
  kill)
    pi=$(pane_id)
    ${=CLI} activate-tab --tab-index $(( $(tab_position) - 2 ))
    ${=CLI} kill-pane --pane-id ${pi} &
  ;;
esac
