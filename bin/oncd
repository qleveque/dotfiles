#!/usr/bin/zsh

directory_changed_callback() {
  N=300
  DIRHIST=${HOME}/.dirhist
  # Add the current directory to the directory history
  touch ${DIRHIST}
  sed -i "\#^$1\$#d" ${DIRHIST}
  echo $1 >> ${DIRHIST}
  echo "$(cat ${DIRHIST} | tail -$N)" > ${DIRHIST}
  # Set wez working directory
  wez-wrap cd "${PWD}"
}

directory_changed_callback "$1" &
