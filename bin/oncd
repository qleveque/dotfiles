#!/usr/bin/env zsh

directory_changed_callback() {
  N=300
  DIRHIST=${HOME}/.dirhist
  # Add the current directory to the directory history
  touch ${DIRHIST}
  sed -i "\#^${WD}\$#d" ${DIRHIST}
  echo $1 >> ${DIRHIST}
  echo "$(cat ${DIRHIST} | tail -$N)" > ${DIRHIST}
}

directory_changed_callback &
