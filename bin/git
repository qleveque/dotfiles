#!/bin/bash

if /usr/bin/git config --list | grep -q core.gitexe; then
  A='\`wslpath ${LOCAL//\\//}\`' B='\`wslpath ${REMOTE//\\//}\`'
  DIFF_CMD="NVIM_GITDIFF=1 LINE=$LINE FILE="$FILE" nvim -d $A $B"
  git.exe \
    -c core.editor='ce(){ wsl.exe -e bash -c "nvim \`wslpath $1\`"; clear; }; ce' \
    -c diff.tool=win -c difftool.win.cmd="wsl.exe -e bash -c \"${DIFF_CMD}\"" \
    "$@"
else
  /usr/bin/git "$@"
fi
