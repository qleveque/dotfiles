#!/bin/bash
# Add an empty search history to less
sed -i '/^\.shell$/i "^' "${HOME}/.lesshst"

if which git.exe &>/dev/null && grep -q "$(git.exe rev-parse --show-toplevel)" ~/.use_git_exe; then
  git.exe \
    -c core.editor='ce(){ wsl.exe -e bash -c "nvim \`wslpath $1\`"; clear; }; ce' \
    -c core.pager='cp(){ wsl.exe -e bash -c "~/bin/less"; }; cp' \
    -c diff.tool=diff \
    -c difftool.diff.cmd='wsl.exe -e bash -c "NVIM_GITDIFF=1 nvim -d \`wslpath ${LOCAL//\\//}\` \`wslpath ${REMOTE//\\//}\`"' \
    "$@"
  exit 0
fi

/usr/bin/git "$@"
