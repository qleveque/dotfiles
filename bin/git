#!/bin/bash
# Add an empty search history to less
[[ "$1" =~ ^(log|diff)$ ]] && sed -i '/^\.shell$/i "^' "${HOME}/.lesshst"

# ~/.use_git_exe should be a file containing the directories using git.exe
if grep -q Microsoft /proc/version && [[ ! "$1" =~ ^(mergetool|difftool|log|diff|show|pick)$ ]] &&
  [[ -n $(cat ~/.use_git_exe 2>/dev/null|xargs -IX sh -c "echo ${PWD}/|grep '^X'") ]]; then
  git.exe -c core.editor='ce(){ wsl.exe -e bash -c "nvim \`wslpath $1\`"; clear; }; ce' "$@" 
  exit 0
fi

/usr/bin/git "$@"
