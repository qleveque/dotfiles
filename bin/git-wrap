#!/usr/bin/env zsh
key="$1" && shift

while getopts "h:f:l:" opt; do case $opt in
  f) [[ -n "${OPTARG}" ]] && file="$(realpath -s --relative-to="${PWD}" "${OPTARG}")" ;;
  l) line="${OPTARG}";;
  h) hash="${OPTARG}";;
esac; done
shift $((OPTIND -1))

_run() { zj-wrap new "${title}" "$@" > /dev/null; exit 0 }
log() { _run "NVIM_DIFF=1 nvim +\":DiffviewFileHistory ${file}\"" } 
show() { _run "NVIM_DIFF=1 nvim +\":DiffviewOpen ${file:+-uno} ${hash:+${hash}^..${hash}} -- $file \"" }

case $key in
  o) [[ -z ${hash} ]] && hash=$(cb paste); title="show ${hash:0:10}" show;;
  d|$'\x04') title="diff ${file:t}" hash= show;;
  s|$'\x13') title="status" hash= file= show;;
  h) title="history ${file:t}" hash= log;;
  l) title="log" hash= file= log;;
  less-commit)
    read line
    for pat in '^commit\ (\w+)' '((HEAD|stash)@\{[0-9]+\})' '^[*| ]*(\w+)'; do
      [[ ${line} =~ ${pat} ]] && { echo "${match[1]}" && exit 0 }
    done
  ;;
esac
