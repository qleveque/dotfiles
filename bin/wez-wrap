#!/usr/bin/env zsh

cmd="$1" && shift

case ${cmd} in
  copy-screen)
    f=$(mktemp)
    cp $1 $f
    NVIM_COPY=1 nvim $f
  ;;
  copy)
    f=$(mktemp)
    zellij action dump-screen -f $f
    NVIM_COPY=1 nvim -c 'norm G3k^' $f
  ;;
  split)
    zellij action new-pane --cwd "${PWD}" --name "" -c -- zsh -c "$1"
  ;;
  new)
    zellij action new-pane --cwd "${PWD}" --name "" -c -- zsh -c "$2"
    zellij action toggle-fullscreen
  ;;
  kill)
    pane=$(pane_id)
    ${wez} cli activate-tab --tab-index $(( $(tab_position ${pane}) - 2 ))
    ${wez} cli kill-pane --pane-id ${pane} &
  ;;
  nvim) ${wez} start --cwd="${PWD}" sh -c "nvim '$1' +$2";;
  cd) printf "\033]7;file://%s%s\033\\" "${HOSTNAME}" "$1";;
esac
