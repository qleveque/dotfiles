#!/usr/bin/zsh
# Run any program

quit() { [[ ${PAUSE} == true ]] && read || echo; exit 0; }
display() { echo "\e[30m$*\e[0m" }
error() { echo "\e[31m$*\e[0m"; quit; }

# Wrapper to run any command showing execution time and returned code
run_cmd() {
  display "PWD: ${PWD}, CMD: $*"
  local start=$(date +%s.%2N)
  eval $*
  local rc=$? et=$(echo "$(date +%s.%2N) - ${start}" | bc)
  display "Returned ${rc} in ${et} seconds"
  quit
}

# Run a script based on the shebang or its extension
run_file() {
  [[ ! -f $1 ]] && error 'File does not exist'
  cd ${1:h}
  local file="${1:t}"

  # Makefile
  [[ ${file} == Makefile ]] && run_cmd "make"

  # Shebang
  local shebang=$(sed -n '1s/^.*#!//p' ${file})
  [[ -n ${shebang} ]] && run_cmd "${shebang} ${file}"

  # Extension
  local f="${file}" n="${file:r}" && [[ $f =~ "[() ]" ]] && f="\"$f\"" n="\"$n\""
  case ${file:e} in
    ahk) run_cmd cmd.exe /C "autohotkey.exe $f";;
    asm) run_cmd "nasm -f elf64 $f && ld -s -o $n.out $n.o && ./$n.out";;
    bash|sh) run_cmd "bash $f";;
    bat|cmd) run_cmd cmd.exe /C "$f";;
    c) run_cmd "clang -o $n.out $f && ./$n.out";;
    cc|cpp) run_cmd "clang++ -w -std=c++23 -o $n.out $f && ./$n.out";;
    cs) run_cmd "csc.exe -out:$n.out $f && ./$n.out";;
    exp) run_cmd "expect $f";;
    f90|f95|f03) run_cmd "gfortran -o $n.out $f && ./$n.out";;
    go) run_cmd "go run $f";;
    groovy) run_cmd "groovy $f";;
    hs) run_cmd "ghc $f && ./$n";;
    html|md) run_cmd "o $f; exit";;
    java) run_cmd "javac $f && java -cp . $n";;
    jl) run_cmd "julia $f";;
    js) run_cmd "node $f";;
    ts) run_cmd "npx ts-node $f";;
    kt) run_cmd "kotlinc $f -include-runtime -d $n.jar && java -jar $n.jar";;
    lisp) run_cmd "clisp $n";;
    lua) run_cmd "lua $f";;
    m4) run_cmd "m4 -I $f > $n";;
    mod|aMod) run_cmd "/opt/voc/bin/voc $f -m && echo && ./$n";;
    nsi) run_cmd cmd.exe /C "makensis $f && $n.exe";;
    pl) run_cmd "perl $f";;
    ps1) run_cmd "powershell.exe -ExecutionPolicy RemoteSigned -f $f";;
    py) run_cmd "python3 $f";;
    r) run_cmd "Rscript $f";;
    rb) run_cmd "ruby $f";;
    rs) run_cmd "rustc $f -o $n.out && ./$n.out";;
    scala) run_cmd "scala $f";;
    sql) run_cmd "sqlite3 $n.db < $f";;
    tex) run_cmd "pdflatex -halt-on-error $f && o $n.pdf && exit";;
    zig) run_cmd "zig build-exe $f && ./$n";;
    zip|tar|rar|7z|xz|txz|bz2|tbz|tbz2|gz|tgz|jar) run_cmd "extract $f";;
    zsh) run_cmd "zsh $f";;
  esac

  # Executable
  [[ -x ${file} ]] && run_cmd "./$f"

  error 'Nothing to do'
}

# Find and run a script file `.run.*` in current or any parent directory
run_project() {
  local files=()
  while [[ ${PWD} != / ]]; do
    files+=($(ls -a1 | grep "^.run." | xargs -r realpath))
    cd ..
  done
  if [[ ! -z ${files} ]]; then
    local selected_file
    if [[ ${#files[@]} -eq 1 ]]; then
      selected_file=${files}
    else
      selected_file=$(
        for f in "${files[@]}"; do printf "%s\t%s\n" "${${f:t}#.run.}" "$f"; done |
        fzf --with-nth=1 |
        awk -F'\t' '{print $2}'
      )
    fi
    [[ -e ${selected_file} ]] && run_file "${selected_file}"
    exit 0
  fi
  PAUSE=true
  error 'No run script'
}

[[ "$1" == "-p" ]] && PAUSE=true && shift
[[ -z "$1" ]] && run_project
run_file "$(readlink -f "$1")"
