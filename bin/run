#!/usr/bin/zsh
# Run any program

# Pause at the end if the '-p' flag is specified
[[ "$1" == "-p" ]] && PAUSE=true && shift

quit() {
  [[ ${PAUSE} == true ]] && read || echo
  exit 0
}

comment() {
  echo "\e[40m$*\e[0m"
}

error() {
  echo "\e[31m$*\e[0m"
  quit
}

run() {
  comment "$*"
  local start=$(date +%s.%2N)
  eval $* $PARAMS
  local rc=$?
  local et=$(echo "$(date +%s.%2N) - ${start}" | bc)
  comment "Returned ${rc} in ${et} seconds"
  quit
}

full_path="$(readlink -f "$1")"

# Makefile and runfile
run_file_pwd="" make_file_pwd=""
while [[ ${PWD} != / ]]; do
  [[ -z ${run_file_pwd} && -f .run ]] && run_file_pwd="${PWD}"
  [[ -z ${make_file_pwd} && -f Makefile ]] && make_file_pwd="${PWD}"
  cd ..
done
if [[ -n ${run_file_pwd}${make_file_pwd} ]]; then
  [[ -n ${run_file_pwd} ]] && comment "(r): ${run_file_pwd}/.run"
  [[ -n ${make_file_pwd} ]] && comment "(m): ${make_file_pwd}/Makefile"
  comment "(*): ${full_path}" && read -k1 -s key
  [[ -n ${run_file_pwd} && $key == "r" ]] && cd ${run_file_pwd} && run "./.run"
  [[ -n ${run_file_pwd} && $key == "m" ]] && cd ${make_file_pwd} && run "make"
fi

# File and params
cd ${full_path:h}
[[ ! -f ${full_path} ]] && error 'File does not exist'
cd ${full_path:h}
file="${full_path:t}" name="${file:r}" ext="${file:e}"
shift
PARAMS="$@"

# Shebang
shebang=$(sed -n '1s/^#!//p' ${file})
[[ -n ${shebang} ]] && run "${shebang} ${file}"

# Extension
if [[ $name =~ ^[[:alnum:]]+$ ]]; then
  f="${file}" n="${name}"
else
  f="\"${file}\"" n="\"${name}\""
fi
case ${ext} in
  ahk) run cmd.exe /C "autohotkey.exe $f";;
  asm) run "nasm -f elf64 $f && ld -s -o $n.out $n.o && ./$n.out";;
  bash|sh) run "bash $f";;
  bat|cmd) run cmd.exe /C "$f";;
  c) run "clang -o $n.out $f && ./$n.out";;
  cc|cpp) run "clang++ -w -std=c++23 -o $n.out $f && ./$n.out";;
  cs) run "csc.exe -out:$n.out $f && ./$n.out";;
  f90|f95|f03) run "gfortran -o $n.out $f && ./$n.out";;
  go) run "go run $f";;
  groovy) run "groovy $f";;
  hs) run "ghc $f && ./$n";;
  html|md) run "o $f; exit";;
  java) run "javac $f && java $n";;
  jl) run "julia $f";;
  js) run "node $f";;
  ts) run "npx ts-node $f";;
  kt) run "kotlinc $f -include-runtime -d $n.jar && java -jar $n.jar";;
  lisp) run "clisp $n";;
  lua) run "lua $f";;
  m4) run "m4 -I $f > $n";;
  mod|aMod) run "voc $f -M && echo && ./$n";;
  nsi) run cmd.exe /C "makensis $f && $n.exe";;
  pl) run "perl $f";;
  ps1) run "powershell.exe -ExecutionPolicy RemoteSigned -f $f";;
  py) run "python3 $f";;
  r) run "Rscript $f";;
  rb) run "ruby $f";;
  rs) run "rustc $f -o $n.out && ./$n.out";;
  scala) run "scala $f";;
  sql) run "sqlite3 $n.db < $f";;
  tex) run "pdflatex -halt-on-error $f && o $n.pdf && exit";;
  zig) run "zig build-exe $f && ./$n";;
  zip|tar|rar|7z|xz|txz|bz2|tbz|tbz2|gz|tgz|jar) run "extract $f";;
  zsh) run "zsh $f";;
esac

# Executable
[[ -x ${file} ]] && run "./$f"

# Not executable
error 'Nothing to do'
