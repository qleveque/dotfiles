#!/usr/bin/bash

# Common packages
sudo apt update -y
sudo apt upgrade -y
sudo apt install -y \
  curl stow cmake vifm zsh tmux fzf tig qalc ripgrep fd-find xsel clang nodejs jq sd lsd

# nvim
local tmp=$(mktemp)
wget -O ${tmp} 'https://github.com/neovim/neovim/releases/latest/download/nvim-linux64.tar.gz'
unzip -o ${tmp} -d "${HOME}"
sudo ln -s "${HOME}/nvim-linux64/bin/nvim" '/usr/bin/nvim'

# vifm devicons
wget 'raw.githubusercontent.com/thimc/vifm_devicons/master/favicons.vifm' -O "${HOME}/.vifm.icons"

# starship
curl -sS https://starship.rs/install.sh | sh -s -- -y

# zim
ZIM_HOME="${HOME}/.zim"
mkdir -p "${ZIM_HOME}"
wget -nv -O "${ZIM_HOME}/zimfw.zsh" 'github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh'
source "${ZIM_HOME}/zimfw.zsh" install -q

# extract
echo '#!/usr/bin/zsh
source ~/.zim/modules/ohmyzsh/plugins/extract/extract.plugin.zsh
extract $1' | sudo tee /usr/bin/extract > /dev/null
sudo chmod +x "/usr/bin/extract"

if grep -q Microsoft /proc/version; then
  # win32yank
  winget.exe install --id=equalsraf.win32yank -e
  # wudo
  sudo wget 'raw.githubusercontent.com/Chronial/wsl-sudo/master/wsl-sudo.py' -O '/usr/bin/wudo'
  sudo chmod +x '/usr/bin/wudo'
fi
