#!/usr/bin/bash

# Common packages
sudo apt update -y
sudo apt upgrade -y
sudo apt install -y \
  curl stow cmake vifm zsh tmux fzf tig qalc ripgrep fd-find xsel clang nodejs jq sd lsd nvim

# vifm devicons
wget 'raw.githubusercontent.com/thimc/vifm_devicons/master/favicons.vifm' -O "${HOME}/.vifm.icons"

# starship
curl -sS https://starship.rs/install.sh | sh -s -- -y

# zim
mkdir -p "${HOME}/.zim"
wget -nv -O "${HOME}/.zim/zimfw.zsh" 'github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh'

# extract
echo '#!/usr/bin/zsh
source ~/.zim/modules/ohmyzsh/plugins/extract/extract.plugin.zsh
extract $1' | sudo tee /usr/bin/extract > /dev/null
sudo chmod +x "/usr/bin/extract"

if grep -q Microsoft /proc/version; then
  # win32yank
  winget.exe install --id=equalsraf.win32yank -e
  # wudo
  sudo wget 'raw.githubusercontent.com/Chronial/wsl-sudo/master/wsl-sudo.py' -O '/usr/bin/wudo'
  sudo chmod +x '/usr/bin/wudo'
  # node
  curl -ksL https://deb.nodesource.com/setup_20.x | sed 's|https://|http://|' | sudo -E bash -
fi
