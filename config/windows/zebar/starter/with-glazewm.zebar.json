{
  "$schema": "https://github.com/glzr-io/zebar/raw/v2.1.0/resources/widget-schema.json",
  "htmlPath": "./with-glazewm.html",
  "zOrder": "top_most",
  "shownInTaskbar": false,
  "focused": false,
  "resizable": false,
  "transparent": true,
  "caching": {
    "defaultDuration": 0,
    "rules": []
  },
  "privileges": {
    "shellCommands": [
      {
        "program": "autohotkey",
        "argsRegex": ".*"
      }
    ]
  },
  "presets": [
    {
      "name": "default",
      "anchor": "bottom_center",
      "offsetX": "0px",
      "offsetY": "0px",
      "width": "25%",
      "height": "30px",
      "monitorSelection": {
        "type": "all"
      },
      "dockToEdge": {
        "enabled": false,
        "edge": null,
        "windowMargin": "0px"
      }
    }
  ]
}
