.shell powershell

# Reload whkd configuration
alt + u                 : taskkill /f /im whkd.exe && start /b whkd
alt + shift + u         : komorebic reload-configuration

alt + q                 : komorebic close
alt + x                 : komorebic minimize

# Focus windows
alt + h                 : komorebic focus left
alt + j                 : komorebic focus down
alt + k                 : komorebic focus up
alt + l                 : komorebic focus right

# Move windows
alt + shift + h         : komorebic move left
alt + shift + j         : komorebic move down
alt + shift + k         : komorebic move up
alt + shift + l         : komorebic move right
# alt + shift + return    : komorebic promote

# Resize
alt + oem_plus          : komorebic resize-axis horizontal increase
alt + oem_minus         : komorebic resize-axis horizontal decrease
alt + shift + oem_plus  : komorebic resize-axis vertical increase
alt + shift + oem_minus : komorebic resize-axis vertical decrease

# Manipulate windows
alt + oem_1                 : komorebic toggle-float
alt + f         : komorebic toggle-monocle

# Workspaces
alt + a                 : komorebic focus-workspace 0
alt + e                 : komorebic focus-workspace 1
alt + w                 : komorebic focus-workspace 2
alt + t                 : komorebic focus-workspace 3
alt + s                 : komorebic focus-workspace 4
alt + c                 : komorebic focus-workspace 5
alt + g                 : komorebic focus-workspace 6
alt + d                 : komorebic focus-workspace 7
alt + b                 : komorebic focus-workspace 8
alt + m                 : komorebic focus-workspace 9
alt + p                 : komorebic focus-workspace 10
alt + r                 : komorebic focus-workspace 11

# Move windows across workspaces
alt + shift + a         : komorebic move-to-workspace 0
alt + shift + e         : komorebic move-to-workspace 1
alt + shift + w         : komorebic move-to-workspace 2
alt + shift + t         : komorebic move-to-workspace 3
alt + shift + s         : komorebic move-to-workspace 4
alt + shift + c         : komorebic move-to-workspace 5
alt + shift + g         : komorebic move-to-workspace 6
alt + shift + d         : komorebic move-to-workspace 7
alt + shift + b         : komorebic move-to-workspace 8
alt + shift + m         : komorebic move-to-workspace 9
alt + shift + p         : komorebic move-to-workspace 10
alt + shift + r         : komorebic move-to-workspace 11
