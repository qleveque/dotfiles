" vim: set ft=vim:
set history=100 ul=100 wmnu is scs nohls ic so=4 stl=" " cf=permdelete
set vicmd=nvim syscalls nofollowlinks sortnumbers syncregs=general trashdir=~/.local/share/Trash
set vifminfo+=dhistory,savedirs,chistory,state,tui,shistory,phistory,dirstack,registers

" Preview
fileviewer *[^/] bat --color always --wrap never --pager never %c -p
nnoremap L :if layoutis('only') | split | view! | else | only | endif <cr>

" Shortcuts
nn xx dd
nn dd "0dd
vn x d
vn d "0d
nn V ggvG
cno <silent> <C-v> <C-r>=system('cb paste')<CR>
map <silent> <C-i> :histnext|oncd<CR>
map <silent> <C-o> :histprev|oncd<CR>
nn <silent> <C-q> :quit<CR>
nn <silent> l :exe('normal! l')|oncd<CR>
nn <silent> h :exe('normal! h')|oncd<CR>
nn U <C-r>
nn A cw
nn I cw<c-a>
nn cw cw<c-u>
nn ! :execute '!'.input('!').' '.expand('%f')<CR>
vn ! :execute '!'.input('!').' '.expand('%l')<CR>
nn <silent> s :sort<CR>
nn <silent> T :touch<Space>
nn <silent> M :mkdir<Space>
nn <silent> yW :exe '!echo -n %c:p | cb copy'<CR>
nn <silent> yM :exe '!printf "%%s" "$(wslpath -w %c:p)" | cb copy'<CR>
nn <silent> yp :exe '!echo -n %d | cb copy'<CR>
nn <silent> yw :exe '!echo -n %c | cb copy'<CR>
nn <silent> é :!wez-wrap split "run -p %f"<CR>
nn <silent> É :!wez-wrap split run<CR>
nn <silent> e :!e %f<CR>
nn <silent> <CR> :!o %f<CR>
nn <silent> <C-g> :exe'!read -k1 k && git-wrap $k -f"'.expand('%f').'"'<CR>
nn <silent> <C-t> :exe system('g=$(${FZF_CTRL_T_COMMAND}|fzf 2>/dev/tty)&&echo goto \"$g\"')|:oncd|:redr<CR>
nn <silent> <C-n> :exe 'cd "./'.system('eval ${FZF_ALT_C_COMMAND}|fzf 2>/dev/tty').'"'|:oncd|:redr<CR>
nn <silent> <C-p> :exe 'cd "'.system('eval ${FZF_CTRL_P_COMMAND}|fzf ${=FZF_CTRL_P_OPTS} 2>/dev/tty').'"'|:oncd|:redr<CR>
nn <silent> P :!filecb paste<CR>
map <silent> Y :!filecb copy %f<CR>

" Commands
com! g :exe system('p=$(readlink "$MARKPATH/%a") && echo cd \"$p\"')|oncd
com! oncd :!oncd "%d"

" Style
hi Win cterm=none ctermfg=none ctermbg=none
hi Executable cterm=none ctermfg=none ctermbg=none
hi StatusLine cterm=none ctermfg=none ctermbg=none
hi CmdLine cterm=none ctermfg=none ctermbg=none
hi TopLine cterm=none ctermfg=none ctermbg=none
hi TopLineSel cterm=none ctermfg=yellow ctermbg=none
hi Border cterm=none ctermfg=black ctermbg=none
hi Directory cterm=bold ctermfg=green ctermbg=none
hi Selected cterm=reverse ctermfg=blue ctermbg=default

source ~/.config/vifm/favicons.vifm
