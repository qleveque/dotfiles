theme "blade-runner"
default_layout "layout"
disable_tips true
pane_frames true
show_startup_tips false
session_name "default"
keybinds clear-defaults=true {
  renametab {
    bind "esc" { UndoRenameTab; SwitchToMode "normal"; }
    bind "enter" { SwitchToMode "normal"; }
  }
  tmux {
    bind "esc" { SwitchToMode "normal"; }
    bind "s" { Run "zsh" { close_on_exit true; name ""; direction "Down"; }; SwitchToMode "normal"; }
    bind "v" { Run "zsh" { close_on_exit true; name ""; direction "Right"; }; SwitchToMode "normal"; }
    bind "r" { SwitchToMode "renametab"; TabNameInput 0; }
    bind "l" { Clear; SwitchToMode "normal"; Write 13; }
    bind "n" { NewTab; SwitchToMode "normal"; }
    bind "z" { ToggleFocusFullscreen; SwitchToMode "normal"; }
    bind "q" { CloseFocus; SwitchToMode "normal"; }
    bind "a" {
      DumpScreen "/tmp/.screen"
      Run "zsh" "-c" "zj-wrap copy-screen /tmp/.screen" {
        close_on_exit true; in_place true; name "Copy";
      }
    }
  }
  shared_among "normal" "locked" {
    bind "F7" { GoToPreviousTab; }
    bind "F8" { GoToNextTab; }
    bind "Ctrl b" { SwitchToMode "tmux"; }
  }
  normal {
    bind "Ctrl h" {MoveFocus "Left"; }
    bind "Ctrl j" {MoveFocus "Down"; }
    bind "Ctrl k" {MoveFocus "Up"; }
    bind "Ctrl l" {MoveFocus "Right"; }
  }
}
