# vim: set ft=bash:
ask() { read -r -p "$1 [y/N]" response && [[ $response == y ]] }
export HOME=$(dirname "$PWD")
mkdir -p "${HOME}/bin" "${HOME}/.config"

# Setup
echo 'Installing environment' && "${HOME}/dotfiles/install"
echo 'Setting up dotfiles' && "${HOME}/dotfiles/setup"
ask 'Overwrite ~/.zshrc ?' && echo source "${HOME}/.zrc" > "${HOME}/.zshrc"
ask 'Change shell to zsh ?' && chsh -s $(which zsh)

# Windows
if grep -q Microsoft /proc/version; then
  echo '-Add `'$(wslpath -m "${HOME}/dotfiles/bin")'` to PATH'
  echo '-Add `'$(wslpath -m "${HOME}/dotfiles/bin/wsl")'` to PATH'
  echo '-Run `wsl.exe -u root usermod -d "'${HOME}/dotfiles $USER'"`'
fi

