#!bash
sudo cp nix/configuration.nix /etc/nixos/configuration.nix

sudo nix-channel --add https://nixos.org/channels/nixos-26.05 nixos
sudo nix-channel --add https://github.com/nix-community/NixOS-WSL/archive/refs/heads/release-26.05.tar.gz nixos-wsl
sudo nix-channel --add https://github.com/nix-community/home-manager/archive/release-26.05.tar.gz home-manager
sudo nix-channel --add https://nixos.org/channels/nixos-unstable nixos-unstable
sudo nix-channel --update
sudo nixos-rebuild switch

nix-shell '<home-manager>' -A install
source setup

if grep -q microsoft /proc/version; then
  tmp="$(cmd.exe /c 'echo %TEMP%\init.bat' 2>/dev/null | tr -d '\r')"
  cp windows/init.bat `wslpath ${tmp}`
  cd /mnt/c
  cmd.exe /c start "" "${tmp}"
fi
