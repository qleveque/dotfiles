" vim: set ft=vim:
set history=100 ul=100 wmnu is scs nohls ic so=4 stl=" " cf=permdelete
set vicmd=nvim syscalls nofollowlinks sortnumbers syncregs=general trashdir=~/.local/share/Trash
set vifminfo+=dhistory,savedirs,chistory,state,tui,shistory,phistory,dirstack,registers

" Shortcuts
nn xx dd
nn dd "0dd
vn x d
vn d "0d
map <C-i> :histnext|oncd<CR>
map <C-o> :histprev|oncd<CR>
nn <C-q> :quit<CR>
nn l :exe('normal! l')|oncd<CR>
nn h :exe('normal! h')|oncd<CR>
nn U <C-r>
nn A cw
nn I cw<c-a>
nn cw cw<c-u>
nn s :sort<CR>
nn T :create<Space>
nn yW :exe '!echo -n %c:p | cb copy'<CR>
nn yp :exe '!echo -n %d | cb copy'<CR>
nn yw :exe '!echo -n %c | cb copy'<CR>
nn é :!wez split "run -p %f"<CR>
nn É :!wez split run<CR>
nn e :!e %f<CR>
nn <CR> :!o %f<CR>
nn <C-g> :exe'!read -k1 k && gitw $k '.expand('%f')<CR>
nn <C-t> :exe system('g=$(${FZF_CTRL_T_COMMAND}|fzf 2>/dev/tty)&&echo goto \"$g\"')|:oncd|:redr<CR>
nn <C-n> :exe 'cd "./'.system('eval ${FZF_ALT_C_COMMAND}|fzf 2>/dev/tty').'"'|:oncd|:redr<CR>
nn <C-p> :exe 'cd "'.system('eval ${FZF_CTRL_P_COMMAND}|fzf ${=FZF_CTRL_P_OPTS} 2>/dev/tty').'"'|:oncd|:redr<CR>
nn P :!filecb paste<CR>
map Y :!filecb copy %f<CR>

" Commands
com! g :exe system('p=$(readlink "$MARKPATH/%a") && echo cd \"$p\"')|oncd
com! create :!set %a&&[[ "${1:0-1}" = "/" ]]&&mkdir "$1"||touch "$1"
com! oncd :!oncd "%d"

" Style
hi Win cterm=none ctermfg=none ctermbg=none
hi Executable cterm=none ctermfg=none ctermbg=none
hi StatusLine cterm=none ctermfg=none ctermbg=none
hi CmdLine cterm=none ctermfg=none ctermbg=none
hi TopLine cterm=none ctermfg=none ctermbg=none
hi TopLineSel cterm=none ctermfg=yellow ctermbg=none
hi Border cterm=none ctermfg=black ctermbg=none
hi Directory cterm=bold ctermfg=green ctermbg=none
hi Selected cterm=reverse ctermfg=blue ctermbg=default
source ~/.favicons.vifm
