[user]
  email = qleveque@hotmail.com
  name = Quentin Leveque
[core]
  editor = nvim
  ignorecase = true
  whitespace = trailing-space
  longpaths = true
  filemode = false
  excludesfile = ~/.gitignore
  abbrev = 6
[push]
  autoSetupRemote = true
[pull]
  rebase = true
[diff]
  tool = nvimdiff
  context = 0
[difftool]
  prompt = false
  trustExitCode = true
  tool = nvim
[merge]
  conflictstyle = diff3
  tool = nvimdiff
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[alias]
  parent = "!h(){ git log -n1 --oneline `git merge-base $*`;};h"
  pick = "!h(){ f=\"$GIT_PREFIX$1\";b=`mktemp`;mv $f $b;git restore $f||>$f;nvim -d $b $f;[ -s $f ]&&git add $f;mv $b $f;};h"
  pretty = "log --graph --pretty=\"%Cred%h%Creset %Cgreen%s%C(auto)%d %C(bold blue)%an %Cgreen%cr%Creset\""
[color "diff"]
  meta = black
  frag = black
  func = black
  commit = blue
