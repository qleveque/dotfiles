# vim: set ft=bash:
color search-result default blue
color cursor default black
color title-focus default black
color title-blur default black
color "--- " black default
color "+++ " black default
color "commit " blue default

set blame-view = author:abbreviated date:custom,format=%d/%m/%Y line-number:interval=1 text
set main-view = date:custom,format=%d/%m/%Y author:abbreviated commit-title:refs=true
set ignore-case = smart-case
set show-changes = no
set refresh-mode = manual
set diff-options = --pretty=medium

bind main G move-last-line
bind generic R refresh
bind generic g none
bind generic gg :0
bind generic y none
bind generic yc @zsh -fc "echo -n %(commit) | cb copy"
bind generic yf @zsh -fc "echo -n %(file) | cb copy"
bind generic yy @zsh -fc "echo -n %(text) | cb copy"
bind generic ; back
bind generic <C-q> :q
bind diff j :/\|\s+(0|[0-9]+\s[\+-]+)$
bind diff k :?\|\s+(0|[0-9]+\s[\+-]+)$
bind diff G move-last-line
bind status j :/^\S+
bind status k :?^\S+
bind status d none
bind status dd !@>rm %(file)
bind status C <git commit
bind status A <git commit --amend
bind status N <git commit --amend --no-edit

bind status t @zsh -c "[[ '%(status)' =~ Staged ]]&&c='restore --staged'||c='add'; git ${=c} '%(file)'"
bind main R <git rebase --interactive %(commit)^

bind generic l :d
bind diff l @git_wrap d -f'%(file)' -r %(stash) %(commit)
bind status m @git_wrap m -f'%(file)'
bind status p @git_wrap p -f'%(file)'
bind status l @zsh -c "[[ '%(status)' =~ Staged ]] && p=-s; git_wrap d -f'%(file)' ${p}"
