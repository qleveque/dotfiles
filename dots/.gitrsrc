map staged l @git_wrap d -f '%(file)' -s
map unstaged l @git_wrap d -f '%(file)'
map files l @git_wrap d -f '%(file)' -r '%(rev)'
map untracked l @git_wrap untracked -f '%(file)'
map unmerged l @git_wrap merge -f '%(file)'
map unstaged p @git_wrap pick -f '%(file)'
map pager d !git_wrap d -f '%(file)' -l '%(line)' -r '%(rev)'
map pager l open_files_app
map stash l open_files_app

map show yt @git show %(rev) --no-patch | grep -o '\(AL\|OPMT\)-[0-9]\+' | cb copy
map unmerged !r !git checkout --ours '%(file)' && git add '%(file)'
set clipboard cb copy
