map global y @echo -n %(rev) | cb copy

map status C >git commit
map status A >git commit --amend
map status N >git commit --amend --no-edit

map untracked D !rm "%(file)"
map modified ! !git restore "%(file)"

map staged l @git_wrap d -f '%(file)' -s
map unstaged l @git_wrap d -f '%(file)'
map show l @git_wrap d -f '%(file)' -r '%(rev)'

map untracked l @git_wrap untracked -f '%(file)'
map unmerged l @git_wrap merge -f '%(file)'
map unstaged p @git_wrap pick -f '%(file)'
